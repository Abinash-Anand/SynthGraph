# Copy to .env.local and fill in. Never put real keys in this file — it is
# committed. .env.local is gitignored.

# --- Demo requests -----------------------------------------------------------
# Demo requests are emailed to the team via Resend. All three must be set for
# email to be sent; with none set, requests are validated and logged only, so
# local and preview deployments still work end to end.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where demo requests land.
DEMO_NOTIFY_TO=contact@synthgraph.dev

# Sender address. Must be on a domain verified in Resend (synthgraph.dev).
# Before the domain is verified, use onboarding@resend.dev to test.
# A friendly name is supported: "SynthGraph <demo@synthgraph.dev>"
DEMO_NOTIFY_FROM=SynthGraph <demo@synthgraph.dev>

# Optional: additionally forward the raw submission to a form service, CRM
# webhook, or internal API. Independent of the email above — set both, either,
# or neither.
DEMO_FORM_ENDPOINT=

# Optional bearer token sent with the forwarded request.
DEMO_FORM_TOKEN=

# --- Site --------------------------------------------------------------------
# Public site URL, used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dashboard / backend API --------------------------------------------------
# Server-only. Base URL of the synthgraph-backend API for authenticated
# dashboard requests. Never expose this with a NEXT_PUBLIC_ prefix — all
# backend calls happen server-side (Route Handlers, Server Components).
# Plain `npm run dev`: http://localhost:3000
# Inside docker-compose: http://backend:3000 (set in docker-compose.yml)
SYNTHGRAPH_API_URL=http://localhost:3000
