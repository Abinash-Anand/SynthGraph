# Optional: forward demo requests to an external endpoint (e.g. a form service,
# CRM webhook, or internal API). When unset, requests are validated and logged
# server-side only.
DEMO_FORM_ENDPOINT=

# Optional bearer token sent with the forwarded request.
DEMO_FORM_TOKEN=

# Public site URL, used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
